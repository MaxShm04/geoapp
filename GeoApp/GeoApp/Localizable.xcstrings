    },
    "A trip starts when you spend a night away from your home region." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Reise beginnt, wenn du eine Nacht außerhalb deiner Heimatregion verbringst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un viaje empieza cuando pasas una noche fuera de tu región de residencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un voyage commence dès que tu passes une nuit hors de ta région de résidence."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un viaggio inizia quando passi una notte fuori dalla tua regione di residenza."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een reis begint zodra je een nacht buiten je thuisregio doorbrengt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma viagem começa quando você passa uma noite fora da sua região de residência."
          }
        }
      }
    },
