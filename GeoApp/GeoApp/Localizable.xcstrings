    },
    "Natural Earth is in the public domain. Country borders are used at a scale of 1:50 million, and 1:10 million for small countries." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural Earth ist gemeinfrei (Public Domain). Verwendet werden die Ländergrenzen im Maßstab 1:50 Mio., für Kleinstaaten 1:10 Mio."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural Earth es de dominio público. Las fronteras de los países se usan a escala 1:50 millones, y 1:10 millones para los países pequeños."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural Earth est dans le domaine public. Les frontières des pays sont utilisées à l’échelle 1:50 millions, et 1:10 millions pour les petits pays."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural Earth è di pubblico dominio. I confini dei paesi sono usati in scala 1:50 milioni, e 1:10 milioni per i paesi piccoli."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Natural Earth is publiek domein. Landsgrenzen worden gebruikt op schaal 1:50 miljoen, en 1:10 miljoen voor kleine landen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Natural Earth é de domínio público. As fronteiras dos países são usadas na escala 1:50 milhões, e 1:10 milhões para países pequenos."
          }
        }
      }
    },
