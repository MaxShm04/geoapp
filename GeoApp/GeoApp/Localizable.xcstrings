    "Your home region is found automatically once the app has recorded a few days." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Heimatregion wird automatisch erkannt, sobald die App ein paar Tage erfasst hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu región de residencia se detecta automáticamente cuando la app haya registrado unos días."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta région de résidence est détectée automatiquement dès que l’app a enregistré quelques jours."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua regione di residenza viene rilevata automaticamente quando l’app avrà registrato qualche giorno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je thuisregio wordt automatisch herkend zodra de app een paar dagen heeft geregistreerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua região de residência é detectada automaticamente assim que o app registrar alguns dias."
          }
        }
      }
    },
    "Your places stay on your iPhone." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Orte bleiben auf deinem iPhone."
          }
        },
        "es" : {
