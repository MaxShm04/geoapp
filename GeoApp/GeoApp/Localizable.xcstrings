    "Matches your location once, offline, to a city and a country. None of this is saved." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordnet deinen Standort einmal offline einer Stadt und einem Land zu. Nichts davon wird gespeichert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asigna tu ubicación una vez, sin conexión, a una ciudad y un país. No se guarda nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associe une fois ta position, hors ligne, à une ville et un pays. Rien n’est enregistré."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
