        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You’ve been to %lld country in %@."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "You’ve been to %lld countries in %@."
                }
              }
            }
          }
        }
      }
    },
