          }
        }
      }
    },
    "Your travel map fills in by itself" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Reisekarte füllt sich von selbst"
          }
        }
      }
    },
    "You’ve been to %lld countries in %@." : {
      "localizations" : {
        "de" : {
