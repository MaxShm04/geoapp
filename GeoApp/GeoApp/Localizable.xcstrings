    "A place appears here as soon as the app records it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobald die App einen Ort erfasst, erscheint er hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lugar aparece aquí en cuanto la app lo registra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lieu apparaît ici dès que l’app l’enregistre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un luogo compare qui non appena l’app lo registra."
          }
        },
        "nl" : {
          "stringUnit" : {
